<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModularShop.Modules.Sales.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularShop.Modules.Sales.Application\ModularShop.Modules.Sales.Application.csproj" />
    <ProjectReference Include="..\ModularShop.Modules.Sales.Domain\ModularShop.Modules.Sales.Domain.csproj" />
    <ProjectReference Include="..\..\..\Kernel\ModularShop.Kernel.Infrastructure\ModularShop.Kernel.Infrastructure.csproj" />
    <!-- The module's Api (its controllers) is part of the module. SalesModule.Register registers this
         assembly as an MVC application part (AddControllers().AddApplicationPart(typeof(OrdersController)...)),
         so this is a REAL, used reference — do NOT remove it (removing it silently drops the module's routes).
         See docs/decision-log.md D13. -->
    <ProjectReference Include="..\ModularShop.Modules.Sales.Api\ModularShop.Modules.Sales.Api.csproj" />
  </ItemGroup>

  <!-- Sales publishes the OrderPlaced integration event on MediatR (registered in SalesModule). -->
  <ItemGroup>
    <PackageReference Include="MediatR" />
  </ItemGroup>

</Project>
