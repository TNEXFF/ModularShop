<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModularShop.Modules.Sales.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularShop.Modules.Sales.Domain\ModularShop.Modules.Sales.Domain.csproj" />
    <ProjectReference Include="..\ModularShop.Modules.Sales.Contracts\ModularShop.Modules.Sales.Contracts.csproj" />
    <!-- Sales calls Warehouse's public synchronous API when placing an order. -->
    <ProjectReference Include="..\..\Warehouse\ModularShop.Modules.Warehouse.Contracts\ModularShop.Modules.Warehouse.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Kernel\ModularShop.Kernel.Application\ModularShop.Kernel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" />
    <!-- No EF Core here: use cases depend on the repository abstractions (Kernel.Domain) and
         IUnitOfWork (Kernel.Application). Clean Architecture is respected — EF Core stays in Infrastructure. -->
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
