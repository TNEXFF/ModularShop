<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModularShop.Modules.Shipping.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularShop.Modules.Shipping.Application\ModularShop.Modules.Shipping.Application.csproj" />
    <ProjectReference Include="..\ModularShop.Modules.Shipping.Domain\ModularShop.Modules.Shipping.Domain.csproj" />
    <ProjectReference Include="..\..\..\Kernel\ModularShop.Kernel.Infrastructure\ModularShop.Kernel.Infrastructure.csproj" />
    <!-- Shipping reacts to the Sales OrderPlaced event, so it references the Sales public contract. -->
    <ProjectReference Include="..\..\Sales\ModularShop.Modules.Sales.Contracts\ModularShop.Modules.Sales.Contracts.csproj" />
    <!-- The module ships its own controllers (discovered by MVC); the host never enumerates them. -->
    <ProjectReference Include="..\ModularShop.Modules.Shipping.Api\ModularShop.Modules.Shipping.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
  </ItemGroup>

</Project>
