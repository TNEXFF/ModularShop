<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModularShop.Modules.Shipping.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularShop.Modules.Shipping.Domain\ModularShop.Modules.Shipping.Domain.csproj" />
    <!-- For IUnitOfWork (the repository interfaces come transitively via Shipping.Domain -> Kernel.Domain). -->
    <ProjectReference Include="..\..\..\Kernel\ModularShop.Kernel.Application\ModularShop.Kernel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" />
    <!-- No EF Core: use cases depend on the repository abstractions + IUnitOfWork, not the DbContext. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Every use case inherits the kernel's UseCase base; a global using makes it available in all files. -->
  <ItemGroup>
    <Using Include="ModularShop.Kernel.Application" />
  </ItemGroup>

</Project>
