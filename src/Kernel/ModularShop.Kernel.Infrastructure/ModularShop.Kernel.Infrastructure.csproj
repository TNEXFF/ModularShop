<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModularShop.Kernel.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularShop.Kernel.Application\ModularShop.Kernel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- ASP.NET Core Identity with EF Core stores. The kernel owns authentication (users, roles), which
         the single host context persists; this brings in UserManager/RoleManager + IdentityDbContext. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- IServiceCollection / IConfiguration (used by the IModule contract) come transitively from
         EF Core SqlServer 10.0.9, so no explicit Microsoft.Extensions.*.Abstractions refs are needed. -->
  </ItemGroup>

</Project>
