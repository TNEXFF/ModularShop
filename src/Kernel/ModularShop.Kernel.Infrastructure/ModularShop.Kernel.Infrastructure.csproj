<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModularShop.Kernel.Infrastructure</RootNamespace>
  </PropertyGroup>

  <!-- The kernel's IModule (KernelModule) and its ICurrentUser adapter (CurrentUser) live here, in the
       kernel's Infrastructure layer — exactly like every feature module's XModule does. Wiring cookie
       Identity (AddIdentity/ConfigureApplicationCookie) and reading the principal (IHttpContextAccessor)
       need ASP.NET Core types, so this layer takes the framework reference. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularShop.Kernel.Application\ModularShop.Kernel.Application.csproj" />
    <!-- KernelModule.Register registers the kernel's own controllers (AuthController) as an MVC application
         part, so it references the kernel's Api project — a REAL, used reference, exactly as every feature
         module's Infrastructure references its own Api. Kernel.Api references only Domain + Application (never
         Infrastructure, per D17), so there is no cycle. See docs/decision-log.md D13. -->
    <ProjectReference Include="..\ModularShop.Kernel.Api\ModularShop.Kernel.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- ASP.NET Core Identity with EF Core stores. The kernel owns authentication (users, roles), which
         the single host context persists; this brings in UserManager/RoleManager + IdentityDbContext. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- IServiceCollection / IConfiguration (used by the IModule contract) come transitively from
         EF Core SqlServer 10.0.9, so no explicit Microsoft.Extensions.*.Abstractions refs are needed. -->
  </ItemGroup>

</Project>
