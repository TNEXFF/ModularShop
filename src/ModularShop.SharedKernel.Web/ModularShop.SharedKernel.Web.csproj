<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- This shared-kernel layer holds ASP.NET Core cross-cutting code (ApiResponse envelope,
       exception middleware, the IModule contract, current-user). A FrameworkReference lets a
       class library use ASP.NET Core types and flows transitively, so modules that reference
       this project can map minimal-API endpoints without referencing ASP.NET Core directly. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularShop.SharedKernel\ModularShop.SharedKernel.csproj" />
  </ItemGroup>

</Project>
