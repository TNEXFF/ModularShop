<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- EF Core design-time tooling (used by `dotnet ef` to build migrations). PrivateAssets=all
       keeps it out of the runtime output. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The host references the shared kernel and every module. It is the ONLY project that knows
       the full set of modules; modules never reference the host or each other's implementations. -->
  <ItemGroup>
    <ProjectReference Include="..\ModularShop.SharedKernel\ModularShop.SharedKernel.csproj" />
    <ProjectReference Include="..\ModularShop.SharedKernel.Infrastructure\ModularShop.SharedKernel.Infrastructure.csproj" />
    <ProjectReference Include="..\ModularShop.SharedKernel.Web\ModularShop.SharedKernel.Web.csproj" />
    <ProjectReference Include="..\Modules\Sales\ModularShop.Modules.Sales\ModularShop.Modules.Sales.csproj" />
    <ProjectReference Include="..\Modules\Warehouse\ModularShop.Modules.Warehouse\ModularShop.Modules.Warehouse.csproj" />
    <ProjectReference Include="..\Modules\Shipping\ModularShop.Modules.Shipping\ModularShop.Modules.Shipping.csproj" />
  </ItemGroup>

</Project>
